# Copy this file to .env.local and fill in real values.
# These are read server-side only, by lib/beehiiv.ts (Server Components /
# Route Handlers) — never exposed to the browser bundle. Also set them in
# your deployment platform's Environment Variables settings (Production +
# Preview) for deployment.

# beehiiv API key (Settings > Integrations > API in the beehiiv dashboard).
BEEHIIV_API_KEY=

# The publication ID the site's articles/subscriptions belong to, e.g.
# pub_00000000-0000-0000-0000-000000000000
BEEHIIV_PUBLICATION_ID=
